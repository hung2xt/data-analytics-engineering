# Copy this file to .env and fill in your own values. .env is gitignored.

# Airflow metadata DB (internal, its own container)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=changeme
POSTGRES_DB=airflow

# Warehouse: your local Postgres, reached from inside the Airflow containers
# via host.docker.internal (macOS/Windows Docker Desktop resolves this to the
# host automatically; Linux uses the extra_hosts entry in docker-compose.yml).
DW_HOST=host.docker.internal
DW_PORT=5432
DW_USER=changeme
DW_PASSWORD=changeme
DW_DB=changeme
DW_SCHEMA=analytical_engineer

# Airflow UID (Linux hosts only; harmless on macOS)
AIRFLOW_UID=50000

# dbt
DBT_PROFILES_DIR=/opt/airflow/dbt/fox_analytics
